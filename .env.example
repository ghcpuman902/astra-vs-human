# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Never commit .env.local or other .env.*.local files.

# Optional: public site URL
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI / Astra (hack credits) — server-only, never NEXT_PUBLIC_
OPENAI_API_KEY=
# Optional model pin once check-in credits / docs name it
# OPENAI_MODEL=gpt-6-astra
# OPENAI_ORG_ID=
# Cheap Sol for pack invent / respawn (not Astra every load). Falls back to OPENAI_MODEL.
# OPENAI_PACK_MODEL=gpt-6.1-sol

# Vercel AI Gateway / AI SDK. Used for Astra plans and for Jev
# (`typesafe-ai/jev` via experimental_decide) when set.
# On Vercel, OIDC (VERCEL_OIDC_TOKEN) can stand in for this key.
# Leave blank here. Set the real value in Vercel project settings.
AI_GATEWAY_API_KEY=

# TypeSafe Jev direct API. Astra + Jev calls POST /v1/systemone only when set.
# Leave blank here. Do not commit a key.
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Convai Laya (System One). Astra + Laya calls POST /v1/systemone only when
# LAYA_API_KEY, IMPOSSIBL_API_KEY, or LAYA_BASE_URL is set. Leave blank.
# Do not commit a key.
# OpenAI Decisions (mix openai-decisions) uses OPENAI_API_KEY or the Gateway:
# Astra/Sol writes planner+captions, then gpt-6-luna Decisions picks the next tap.
# LAYA_API_KEY uses https://api.laya.studio unless LAYA_BASE_URL is set.
# A lone IMPOSSIBL_API_KEY uses https://api.impossibl.com and model
# convaiinnovations/laya.
LAYA_API_KEY=
IMPOSSIBL_API_KEY=
# LAYA_BASE_URL=https://api.laya.studio

# Pack gen budget (ms) — keep wall under 60s for playable pack
PACK_GEN_BUDGET_MS=55000
